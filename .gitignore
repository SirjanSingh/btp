# ── Crash dumps ──────────────────────────────────────
core.*

# ── Datasets (too large for git) ─────────────────────
rooftop/dataset/
rooftop/dataset_crops/
solar_panel/bdappv/
solar_panel/bdappv_crops/
airs/
test_indian/
# data/ is the canonical dataset dir on this server (~9 GB: AIRS, the Jaipur
# mosaic, Open Buildings). Ignore its contents but keep the README that explains
# what is supposed to live there — without this rule a `git add -A` stages 8 GB
# of GeoTIFFs.
data/*
!data/README.md

# ── Model weights (too large) ────────────────────────
# Runs write into timestamped subdirectories, so match at any depth, not just
# directly under checkpoints/.
**/checkpoints/**/*.pth
rooftop/checkpoints/*.pth
solar_panel/checkpoints/*.pth

# ── Container deps / scratch (live on /home, never in git) ───
# See run_docker.sh: deps install into .pydeps as PYTHONUSERBASE and the
# container's /tmp is bind-mounted to .tmp, because host / is full.
.pydeps/
.venv-docker/
.tmp/

# ── Generated outputs ────────────────────────────────
rooftop/infer_results/
rooftop/eval_results/overlays/
rooftop/eval_results/per_sample_iou.csv
solar_panel/eval_results/

# ── TensorBoard ──────────────────────────────────────
**/tb_logs/

# ── Python ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/

# ── Jaipur target-domain data (1+ GB) ────────────────
daraset/
jaipur/
jaipur_crops/
adapt/labels/
adapt/cache/

# ── Papers & reference rasters ───────────────────────
*.pdf
rooftop/*.tif
rooftop/eval_results/*.png
